{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luhistory",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./dist",
    // Astro builds directory-style routes (`/about/index.html`) and emits
    // canonical URLs + sitemap entries with a trailing slash, so redirect
    // `/about` -> `/about/` to match. Mirrors the previous Pages behaviour.
    "html_handling": "force-trailing-slash",
    // Serve the Astro-generated 404 page for unmatched routes.
    "not_found_handling": "404-page"
  }
}
